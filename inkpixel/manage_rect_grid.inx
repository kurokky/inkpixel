<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Edit Rows and Columns</name>
    <id>net.black-tree.manage_rect_grid</id>
    <param name="direction" type="optiongroup" appearance="combo" gui-text="Direction:">
        <option value="top">Top</option>
        <option value="bottom">Bottom</option>
        <option value="left">Left</option>
        <option value="right">Right</option>
    </param>
    
    <param name="amount" type="int" min="1" max="100" gui-text="(Cols/Rows) number:">1</param>
    
    <param name="mode" type="optiongroup" appearance="combo" gui-text="Action:">
        <option value="add">Add</option>
        <option value="delete">Delete</option>
    </param>
    <param name="resize_doc" type="bool" gui-text="Change the document size?">false</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Ink/Pixel"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">manage_rect_grid.py</command>
    </script>
</inkscape-extension>