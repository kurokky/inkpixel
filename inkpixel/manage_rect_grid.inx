<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension  translationdomain="inkpixel" xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Edit Rows and Columns</name>
    <id>net.black-tree.manage_rect_grid</id>
    <param name="direction" type="optiongroup" appearance="combo" gui-text="Direction:">
        <option value="top" translatable="yes">Top</option>
        <option value="bottom" translatable="yes">Bottom</option>
        <option value="left" translatable="yes">Left</option>
        <option value="right" translatable="yes">Right</option>
    </param>
    <param name="amount" type="int" min="1" max="100" gui-text="(Cols/Rows) number:">1</param>
    <param name="mode" type="optiongroup" appearance="combo" gui-text="Action:">
        <option value="add" translatable="yes">Add</option>
        <option value="delete" translatable="yes">Delete</option>
    </param>
    <param name="resize_doc" type="bool" gui-text="Change the document size?">false</param>
    <effect needs-live-preview="false">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Ink/Pixel"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">manage_rect_grid.py</command>
    </script>
</inkscape-extension>