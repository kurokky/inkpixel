<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension  translationdomain="inkpixel" xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Perler(5mm)</name>
    <id>net.black-tree.cs.dot.5mm</id>
    <dependency type="executable" location="extensions">pixel_manage_main.py</dependency>
    <param name="command" type="string" gui-hidden="true">size</param>
    <param name="dot_size" type="string" gui-hidden="true">5</param>
    <param name="confirm_delete" type="bool" gui-text="Are you sure? The current data will be deleted.">false</param>
    <effect needs-live-preview="false">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Ink/Pixel">
                <submenu name="Pixel Size: Beads"/>
            </submenu>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">pixel_manage_main.py</command>
    </script>
</inkscape-extension>