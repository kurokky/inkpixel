<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension translationdomain="inkpixel"  xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Import IBE json data</name>
    <id>net.black-tree.pixel.ibe</id>
    <param name="json_file" type="path" mode="file" filetypes="json" gui-text="JSONファイルを選択:"></param>
    <label appearance="header">説明</label>
    <label>選択したJSONファイルを読み込み、その中身をキャンバスにテキストとして表示します。</label>
    <param name="resize_doc" type="bool" gui-text="Change the document size?">false</param>
    <effect needs-live-preview="false">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Ink/Pixel"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">ibe.py</command>
    </script>
</inkscape-extension>