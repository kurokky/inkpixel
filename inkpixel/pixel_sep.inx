<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension  translationdomain="inkpixel" xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Split by Color</name>
    <id>net.black-tree.pixel.sep</id>
    <dependency type="path" location="inx">pixel_manage_main.py</dependency>
    <dependency type="executable" location="extensions">pixel_manage_main.py</dependency>
    <param name="command" type="string" gui-hidden="true">sep</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Ink/Pixel">
                <submenu name="Create Layer" />
            </submenu>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">pixel_manage_main.py</command>
    </script>
</inkscape-extension>